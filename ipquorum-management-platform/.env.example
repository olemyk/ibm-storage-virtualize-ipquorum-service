# IPQuorum Management Platform - Environment Configuration
# Copy this file to .env and update with your values

# ===== General Configuration =====
COMPOSE_PROJECT_NAME=ipquorum

# ===== Backend API Server =====
# Security
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRATION=24h

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Performance
MAX_CONCURRENT_OPERATIONS=10
OPERATION_TIMEOUT=300s

# ===== IPQuorum Agent Configuration =====
# Enable/disable agent integration
IPQUORUM_AGENT_ENABLED=false

# Agent connection details
IPQUORUM_AGENT_HOST=
IPQUORUM_AGENT_PORT=9090
IPQUORUM_AGENT_API_KEY=

# TLS settings
IPQUORUM_AGENT_TLS_ENABLED=true
IPQUORUM_AGENT_TLS_VERIFY=true

# ===== Web Dashboard =====
WEB_PORT=3000

# Nginx performance tuning
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# ===== Monitoring Stack =====
# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password
GRAFANA_ROOT_URL=http://localhost:3001

# AlertManager
ALERTMANAGER_PORT=9093

# ===== Example Configurations =====

# Development (local testing)
# IPQUORUM_AGENT_ENABLED=false
# LOG_LEVEL=debug
# JWT_SECRET=dev-secret-key

# Production (with agent)
# IPQUORUM_AGENT_ENABLED=true
# IPQUORUM_AGENT_HOST=10.0.0.100
# IPQUORUM_AGENT_PORT=9090
# IPQUORUM_AGENT_API_KEY=your-secure-api-key
# IPQUORUM_AGENT_TLS_ENABLED=true
# IPQUORUM_AGENT_TLS_VERIFY=true
# LOG_LEVEL=info
# JWT_SECRET=generate-with-openssl-rand-base64-32

# Production (standalone - no agent)
# IPQUORUM_AGENT_ENABLED=false
# LOG_LEVEL=info
# JWT_SECRET=generate-with-openssl-rand-base64-32
# GRAFANA_ADMIN_PASSWORD=secure-password-here

